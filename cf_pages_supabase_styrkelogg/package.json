{
  "name": "styrkelogg-pages",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:migrate:local": "wrangler d1 migrations apply styrkelogg --local",
    "db:migrate:remote": "wrangler d1 migrations apply styrkelogg --remote",
    "dev": "node scripts/build.mjs && wrangler pages dev dist"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
